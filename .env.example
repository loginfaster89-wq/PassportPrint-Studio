# ════════════════════════════════════════════════════════════
# PassportPrint Studio Backend — Environment Variables
# ════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is in .gitignore.

# ── Server ──
PORT=4000
# Comma-separated list of allowed origins for CORS.
# Example: https://ajaykumar581.github.io,https://yourdomain.com
# Use * for any origin (NOT recommended for production).
CORS_ORIGINS=*

# ── JWT ──
# Long random string used to sign auth tokens.
# Generate with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-chars

# ── Razorpay ──
# Get these from https://dashboard.razorpay.com/app/keys
# Use test keys (rzp_test_*) during development, then switch to live (rzp_live_*).
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ── Pricing (INR, paise) ──
# 1 INR = 100 paise. 4900 paise = ₹49.
PRICE_WEEKLY=4900
PRICE_MONTHLY=14900

# ── Database ──
# SQLite file path (absolute or relative to backend/ dir).
# On Render/Railway with persistent disk, set this to /data/pps.db
DB_PATH=./pps.db

# ── Daily download limits ──
# Number of A4 sheets (download + print combined) allowed per 24h per user.
# 0 = unlimited.
FREE_DAILY_SHEETS=2
WEEKLY_DAILY_SHEETS=0
MONTHLY_DAILY_SHEETS=0

# Timezone offset (in minutes) used to decide when "daily" counters reset.
# 330 = IST (UTC+5:30). Set to 0 for UTC.
DAILY_RESET_TZ_OFFSET_MIN=330

# ── SMTP (for email OTP verification on signup) ──
# Gmail with App Password works out of the box.
# 1) Enable 2FA on the sender Gmail account.
# 2) Create an App Password: https://myaccount.google.com/apppasswords
# 3) Paste the 16-char app password (spaces optional) into SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# Optional: "From" header shown to recipients. Defaults to SMTP_USER.
SMTP_FROM="Studio Print <your-sender@gmail.com>"

# OTP TTL in seconds. Default 10 minutes.
OTP_TTL_SEC=600
