# ════════════════════════════════════════════════════════════
# PassportPrint Studio Backend — Environment Variables
# ════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is in .gitignore.

# ── Server ──
PORT=4000
# Comma-separated list of allowed origins for CORS.
# Example: https://ajaykumar581.github.io,https://yourdomain.com
# Use * for any origin (NOT recommended for production).
CORS_ORIGINS=*

# ── JWT ──
# Long random string used to sign auth tokens.
# Generate with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-chars

# ── Razorpay ──
# Get these from https://dashboard.razorpay.com/app/keys
# Use test keys (rzp_test_*) during development, then switch to live (rzp_live_*).
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ── Pricing (INR, paise) ──
# 1 INR = 100 paise. 4900 paise = ₹49.
PRICE_WEEKLY=4900
PRICE_MONTHLY=14900

# ── Database ──
# SQLite file path (absolute or relative to backend/ dir).
# On Render/Railway with persistent disk, set this to /data/pps.db
DB_PATH=./pps.db
